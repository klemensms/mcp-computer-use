# Long String Allowlist
# Patterns that match known safe long strings (35+ chars) detected by the
# pre-commit hook. These are typically npm paths, npm integrity hashes, and URLs.
#
# Lines starting with # are comments. Blank lines are ignored.
# Patterns use grep -E (extended regex) syntax, matched against extracted strings.

# --- npm package import paths ---
modelcontextprotocol/sdk
mcp-consultant-tools
mcp-computer-use

# --- npm integrity hashes in package-lock.json ---
sha512-
^[A-Za-z0-9+/]{86}(==)?$
^[A-Za-z0-9+/]{43}$

# --- Upstream attribution references ---
injaneity/pi-computer-use
actuallyepic/background-computer-use
background-computer-use
BackgroundComputerUseKit
BackgroundComputerUseRuntime

# --- Git commit SHAs (40+) and content hashes (e.g. SwiftPM Package.resolved
#     originHash is SHA-256 = 64 hex chars). Pure-hex strings of 40+ chars are
#     git SHAs / content digests, not credential formats. ---
^[a-f0-9]{40,}$

# --- Project file paths that appear in docs and commit messages ---
~/Obsidian/
native/macos/Sources/
docs/superpowers/
McpComputerUseHelper

# --- Swift / Apple framework identifiers (can be long) ---
ApplicationServices
ScreenCaptureKit
kAXFocusedUIElementAttribute
kAXFocusedWindowAttribute
kAXMinimizedAttribute
CGWindowListCreateDescriptionFromArray

